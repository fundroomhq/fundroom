# Fail fast on the wrong Node/pnpm instead of "working" with subtle breakage.
engine-strict=true
# Hoist nothing to the root node_modules; packages must declare what they import.
# (dependency-cruiser and the ESM-only rule rely on this.)
shamefully-hoist=false
public-hoist-pattern[]=
# Don't pull in devDependencies of dependencies.
resolution-mode=highest
# Reproducible installs in CI.
prefer-frozen-lockfile=true
# Don't run arbitrary lifecycle scripts from dependencies (see onlyBuiltDependencies).
strict-dep-builds=true
# Workspace packages depend on each other by link, never by registry version.
link-workspace-packages=true
save-workspace-protocol=rolling
