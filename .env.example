# FundRoom environment reference. Copy to .env for local dev (never commit .env).
# Every secret also accepts NAME_FILE=/run/secrets/name for Docker / Kubernetes secrets.
# Booleans: true/false/1/0/yes/no/on/off. Lists: comma-separated.

# --- process ---------------------------------------------------------------
APP_ENV=dev                      # dev | test | staging | prod
LOG_LEVEL=info                   # trace | debug | info | warn | error
HOST=0.0.0.0
PORT=3000
ROLES=api,web,worker             # all-in-one by default; scale out with separate processes
#WORKER_MODE=embedded            # embedded | external | off (shorthand that adds/removes the worker role)
WORKER_CONCURRENCY=5
#MODULES=access,content,data-room,updates   # omit to load every compiled-in module

# --- public identity -------------------------------------------------------
BASE_URL=http://localhost:3000   # https required in staging/prod
#BASE_PATH=/investors            # path-mount mode only
# Path mounts: public URLs another site's reverse proxy serves the portal under,
# comma-separated, max 16, https in staging/prod, TENANCY_MODE=single only. The proxy sends
# X-Forwarded-Prefix: <prefix>; only a prefix listed here is honoured (TRUST_PROXY not required).
# BASE_URL may be one of these (then BASE_PATH may stay unset behind a stripping proxy). Recipes:
# docs/embed/. Several hosts sharing one prefix are told apart only by X-Forwarded-Host, which
# needs TRUST_PROXY=true and an edge that keeps the host proxies' header (EDGE_TRUSTED_PROXIES on
# the shipped Caddy); otherwise give each host its own prefix. Never list a mount origin in
# CORS_ALLOWED_ORIGINS. Responses served through a mount carry no HSTS.
#PATH_MOUNTS=https://acme.com/investors,https://www.acme.com/investors
TRUST_PROXY=false                # true behind Caddy / a load balancer
# With TRUST_PROXY=true: the client address is the X-Forwarded-For entry TRUST_PROXY_HOPS
# places from the right (entries further left are client-supplied), or the single header named by
# CLIENT_IP_HEADER, which the platform edge overwrites (Fly-Client-IP, True-Client-IP on Render,
# X-Real-IP on Railway / ingress-nginx). Behind Cloudflare prefer CLOUDFLARE_TRUSTED_PROXY=on below
# (leave CLIENT_IP_HEADER unset): it believes CF-Connecting-IP only from Cloudflare's own addresses.
#TRUST_PROXY_HOPS=1              # proxies in front that append to X-Forwarded-For
#CLIENT_IP_HEADER=
# Edge forwarding: a Cloudflare Worker in front of a PaaS that routes by Host
# (Railway) and overwrites X-Forwarded-Host. The Worker sends the customer hostname and visitor IP
# in private headers plus X-Fundroom-Edge: <EDGE_SHARED_SECRET>; the app believes them only when the
# secret matches (a wrong one gets 403; none = an ordinary request). Both names must start with
# X-Fundroom- (the Worker strips that namespace from inbound requests); CLIENT_IP_HEADER may never be
# an X-Fundroom-* header. Keep TRUST_PROXY=true for direct (non-edge) traffic (doctor warns). Not
# with PATH_MOUNTS.
#FORWARDED_HOST_HEADER=X-Fundroom-Forwarded-Host   # set together with EDGE_SHARED_SECRET
#FORWARDED_CLIENT_IP_HEADER=X-Fundroom-Client-IP  # must differ from FORWARDED_HOST_HEADER; unset = every edge visitor shares the edge's address (doctor warns)
#EDGE_SHARED_SECRET=              # openssl rand -hex 32 (32+ chars); the Worker's EDGE_SHARED_SECRET holds the same value
#EDGE_SHARED_SECRET_PREVIOUS=     # rotation only: the old secret, still accepted; unset once the Worker sends the new one
ROBOTS=noindex                   # secure default; investor content is never indexed
CSP_TRUSTED_TYPES=enforce        # enforce|report — Trusted Types in the page CSP; report = report-only rollback switch
INSTANCE_NAME=FundRoom           # shown in emails, TOTP issuer, web shell title
#SECURITY_TXT_CONTACT=mailto:security@example.com   # /.well-known/security.txt Contact (RFC 9116); unset points at the FundRoom project
#SECURITY_TXT_POLICY=https://example.com/security   # optional disclosure policy URL
#RATE_LIMIT_MULTIPLIER=1         # >1 only for k6/ZAP runs; needs APP_ENV set explicitly to dev/test/staging
#CORS_ALLOWED_ORIGINS=https://www.example.com   # extra origins for credentialed /api/v1 calls (exact match)
CUSTOM_DOMAIN_DRIVER=caddy-ask   # caddy-ask: the edge issues per-domain certs from the `ask` endpoint | manual: verify DNS only, you terminate TLS | cloudflare-saas: Cloudflare for SaaS issues and serves (docs/runbooks/custom-domains.md)
#CLOUDFLARE_API_TOKEN=           # cloudflare-saas: API token with Zone → SSL and Certificates → Edit on the zone below
#CLOUDFLARE_ZONE_ID=             # cloudflare-saas: the 32-hex zone id holding the custom hostnames
#CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4   # test seam only; any other value refused in prod
#CLOUDFLARE_TRUSTED_PROXY=off    # on: client address from CF-Connecting-IP when the peer (as TRUST_PROXY derives it) is in Cloudflare's ranges; needs TRUST_PROXY=true
#CUSTOM_DOMAIN_CNAME_TARGET=portal.example.com   # what customers CNAME to; defaults to the BASE_URL host (a managed host points at <slug>.customers.<domain>)
#CUSTOM_DOMAIN_EDGE_ADDRESSES=203.0.113.10,2001:db8::10   # override for apex A/AAAA checks; unset resolves CUSTOM_DOMAIN_CNAME_TARGET's own addresses (which is what you want)
#DOH_ENDPOINTS=https://1.1.1.1/dns-query,https://8.8.8.8/resolve   # DoH JSON resolvers used to verify a domain; two DISTINCT resolvers must agree (default: Cloudflare then Google)
#SPREADSHEET_DRIVER=sheets-google  # sheets-google: nightly KPI sync reads a Google Sheet as a service account (the admin pastes the JSON and shares the sheet with it) | noop: never talk to Google
#ACCREDITATION_DRIVER=manual      # manual: the investor uploads evidence and a staff member decides a 506(c) verification (the only driver; a vendor bureau would be a second id)
#ACCREDITATION_DRIVERS=verifyinvestor,parallel-markets  # accreditation vendors workspace admins may connect (default both, `none` = vendors off, manual review only); removing one keeps existing connections but no new ones (docs/accreditation/README.md)
#ESIGN_DRIVERS=documenso,docuseal,docusign,dropbox-sign  # e-sign vendors workspace admins may connect (default all four); removing one keeps existing connections but no new ones (docs/esign/README.md)
#ESIGN_MAX_ARTIFACT_BYTES=26214400  # largest signed PDF + certificate (together) the e-sign collector keeps (1 MiB–100 MiB); larger → artifact_too_large, envelope stays completed without a copy
#WEB_DIST_PATH=/app/apps/web/dist   # built SPA (apps/web/dist) for the web role; placeholder page when unset
SHUTDOWN_TIMEOUT_MS=25000        # SIGTERM drain budget for requests and jobs
DATA_DIR=/data                   # persistent dir: generated secret.key, setup-token, default storage
#SETUP_TOKEN=                    # fix the first-run setup token (deploy templates without log access); else it is generated and printed to the logs

# --- database --------------------------------------------------------------
DATABASE_URL=postgres://seedhost:seedhost@localhost:5432/seedhost
# staging/prod: a host outside the private network (not an RFC 1918/loopback IP, a single-label
# name or *.internal/*.svc/*.local/...) needs ?sslmode=verify-full (+ &sslrootcert=/path/ca.pem).
#DATABASE_ACCEPT_UNVERIFIED_TLS=false  # escape hatch: the host is private after all
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=30000
TENANCY_MODE=single              # single: one workspace, no slug routing | multi: resolve by slug/host
MIGRATE_ON_START=true            # Compose/all-in-one only; Helm uses a pre-upgrade Job
DATABASE_WAIT_TIMEOUT_MS=60000   # serve/migrate wait this long for Postgres to accept connections
BACKUP_BEFORE_MIGRATE=false

# --- secrets / crypto ------------------------------------------------------
# Exactly one of the two. Start with the single key; move to the ring when you rotate.
FUNDROOM_SECRET_KEY=              # openssl rand -base64 32 (formerly SEEDHOST_SECRET_KEY: still read, doctor warns; both may be set only to the same value)
#SECRET_KEY_RING=v2:<new>,v1:<old>   # newest first; old keys stay decrypt-only
#SESSION_SECRET=                  # optional; derived from the key ring when unset
KMS_DRIVER=local                 # local: per-workspace DEKs wrapped under the key ring; AWS/GCP/Vault adapters later

# --- identity --------------------------------------------------------------
AUTH_PASSWORD_ENABLED=false      # investors use email codes / passkeys; staff OIDC or OTP + TOTP/passkey
AUTH_HIBP_CHECK=true             # breached-password check (k-anonymity) when passwords are enabled
AUTH_HIBP_FAIL_MODE=open         # open|closed — HIBP unreachable: accept unchecked (open) or refuse with 503 (closed); both audited
AUTH_MAGIC_LINK_ENABLED=true     # host-level switch; workspaces opt in
#PASSKEY_RP_ID=investors.example.com   # defaults to the BASE_URL host
PASSKEY_RP_NAME=FundRoom
#OIDC_ISSUER_URL=https://accounts.google.com   # install-wide staff SSO (generic OIDC, PKCE)
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_TRUST_EMAIL=false          # true only for the company's own IdP: links verified emails to existing accounts
#OIDC_ALLOWED_DOMAINS=acme.com   # restrict which email domains the provider may assert
#OIDC_TRUST_MFA=false            # every login from this IdP counts as MFA (only if the IdP enforces it and emits no amr)
#OIDC_MFA_ACR=                   # comma-separated acr values that mean MFA at the IdP
#SSO_PROTOCOLS=oidc,saml         # per-workspace staff SSO protocols admins may configure (default both, `none` = off); removing one keeps an existing connection but it can no longer sign in (docs/sso/README.md)
#SCIM_ENABLED=true               # SCIM 2.0 provisioning at ${BASE_URL}/scim/v2; false = 404 there and no SCIM tokens
#CENTRAL_AUTH=off                # on: custom domains and <slug> hosts sign in via BASE_URL and get a session bound to that workspace; passkeys then work on custom domains (docs/runbooks/central-auth.md)

# --- managed-host control plane (docs/runbooks/control-plane.md) --------
# Everything here is inert with CONTROL_PLANE=off (the default): no operator surface, no plans,
# no billing or sanctions routes or jobs, and no workspace is ever suspended.
#CONTROL_PLANE=off               # on requires TENANCY_MODE=multi
#CELL_ID=default                 # the cell this process serves; other cells' workspaces answer 421 wrong_cell + X-Fundroom-Cell
#PLATFORM_OPERATOR_CIDRS=203.0.113.0/24   # operator networks (client address as TRUST_PROXY derives it); elsewhere /api/v1/platform/* is 404
#SIGNUP_MODE=off                 # open: self-service signup on the canonical host (needs CONTROL_PLANE=on)
#SIGNUP_DEFAULT_PLAN=starter     # required with SIGNUP_MODE=open; signup answers 404 until the plan exists
#SIGNUP_TERMS_VERSION=1          # 1-10000: the terms version a signup accepts (platform-terms:v<n>); raise it when TERMS_URL changes materially
# Host footer links (any install): shown on the admin area, signup, setup, operator console
# and canonical-host sign-in; never on the investor portal or a workspace host's sign-in (the tenant
# is the controller there). https:// only (http:// for localhost); only SUPPORT_URL may be mailto:.
# doctor warns when SIGNUP_MODE=open has no TERMS_URL.
#TERMS_URL=https://www.example.com/terms   # https only; also linked next to the signup terms checkbox
#PRIVACY_URL=https://www.example.com/privacy
#SUPPORT_URL=mailto:support@example.com   # or an https URL
#STATUS_URL=https://status.example.com
# Operators: `fundroom operator enrol-link <email>` (one-time link to enrol a passkey/TOTP), then `fundroom operator grant <email>`
# Billing (docs/runbooks/billing.md): none | manual (you record subscriptions) | stripe
#BILLING_DRIVER=none
#STRIPE_SECRET_KEY=sk_...        # or a restricted key rk_...; required with stripe
#STRIPE_WEBHOOK_SECRET=whsec_... # signing secret of the endpoint ${BASE_URL}/webhooks/billing/stripe
#STRIPE_API_BASE=https://api.stripe.com   # test seam only; any other value refused in prod
#BILLING_GRACE_DAYS=14           # 0-60: past_due/unpaid → suspended after this many days
#BILLING_METER_SEATS_EVENT=fundroom_staff_seats   # Stripe meter event_name for the daily staff-seat count (must match your meter)
#BILLING_METER_STORAGE_EVENT=fundroom_storage_gb  # Stripe meter event_name for daily storage in GB (letters, digits, _; ≤100)
# Sanctions screening of tenant companies (docs/runbooks/sanctions.md): none | ofac | opensanctions
#SANCTIONS_DRIVER=none           # prod with CONTROL_PLANE=on and none → doctor warning
#SANCTIONS_OFAC_URL=https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/   # test seam (https in staging/prod); needs egress to that host and *.amazonaws.com
#SANCTIONS_OPENSANCTIONS_URL=http://yente.internal:8000   # required with opensanctions (yente or https://api.opensanctions.org); https whenever a key is set
#SANCTIONS_OPENSANCTIONS_API_KEY=   # sent only to api.opensanctions.org or a host below. OpenSanctions data is CC BY-NC: a managed host needs a commercial licence
#SANCTIONS_OPENSANCTIONS_API_KEY_HOSTS=   # other hosts the key may go to (an authenticating proxy); any other host with a key is refused
#SANCTIONS_MATCH_THRESHOLD=0.88  # 0.5-1; a name score at or above it is a potential match (held / queued for an operator)

# --- data residency (docs/runbooks/residency.md) ----------------------
# Declared by you, not verified by the product: set them to where THIS install's database, bucket
# and backups actually are. Tenants see them on Settings → Data residency and in the DPA template.
#DATA_REGION=eu                  # ^[a-z][a-z0-9-]{0,31}$; one database = one region, never changed once it holds workspaces
#DATA_REGION_LABEL=European Union (Frankfurt, Germany)
#DATA_REGION_JURISDICTION=eu     # eu | uk | ch | us | ca | au | other
#BACKUP_LOCATION=European Union (Frankfurt, Germany)
# A host with cells in more than one region: every cell points at one shared directory database
# (slugs, verified hostnames, cells, moves; no personal data). Needs CONTROL_PLANE=on, DATA_REGION,
# DATA_REGION_JURISDICTION and (prod/staging) STORAGE_DRIVER=s3. Unset = local mode.
#DIRECTORY_DATABASE_URL=postgres://seedhost:…@directory.internal:5432/directory?sslmode=verify-full
#DIRECTORY_DATABASE_POOL_MAX=4
#DIRECTORY_DATABASE_ACCEPT_UNVERIFIED_TLS=false   # prod/staging require a private host or sslmode=verify-full|verify-ca; true accepts an unverified public connection (not recommended)
#MOVE_SOURCE_RETENTION_HOURS=0   # 0-720: hours the source cell keeps a moved workspace's copy after the switch
#MOVE_MAX_BUNDLE_BYTES=53687091200   # largest bundle this cell downloads for a move (spooled under DATA_DIR/moves/)

# --- AI assist (docs/runbooks/ai-assist.md) ---------------------------
# Off unless a provider is set; each workspace then opts in (Settings → AI assist) and every
# suggestion is reviewed and saved by staff. FundRoom never trains models on workspace data.
#AI_PROVIDER=none                # none | openai-compatible (Ollama, vLLM, llama.cpp, LM Studio, hosted OpenAI-compatible) | anthropic
#AI_BASE_URL=http://ollama:11434 # required with openai-compatible (a trailing /v1 is fine); prod/staging: https unless the host is operator-run (private address / service name). anthropic: test seam, must stay https://api.anthropic.com in prod
#AI_API_KEY=                     # required with anthropic
#AI_MODEL=qwen3.5:9b             # required when AI_PROVIDER is not none (anthropic e.g. claude-opus-5)
#AI_HOSTING=                     # openai-compatible only: self_hosted | third_party (unset: self_hosted iff AI_BASE_URL is a private/service host; self_hosted on a public host → doctor warning)
#AI_PROVIDER_LABEL=              # sub-processor name; required for a third-party openai-compatible provider
#AI_PROVIDER_LOCATION=           # where the provider processes data (human text)
#AI_PROVIDER_JURISDICTION=       # eu | uk | ch | us | ca | au | other | varies; required for a third-party openai-compatible provider
#AI_JSON_MODE=json_schema        # openai-compatible only: json_schema | json_object | prompt
#AI_TOKEN_PARAM=max_tokens       # openai-compatible only: max_tokens | max_completion_tokens
#AI_TIMEOUT_MS=180000            # 5000-900000 per model call
#AI_MAX_OUTPUT_TOKENS=4000       # 256-32000
#AI_MAX_INPUT_CHARS=60000        # 4000-400000 prompt size budget (small local contexts)
#AI_CONCURRENCY=2                # 1-32 model calls in flight per process
#AI_MONTHLY_TOKEN_BUDGET=2000000 # per workspace per UTC month (input+output); a workspace may set less; ≥ 2×AI_MAX_INPUT_CHARS+3×AI_MAX_OUTPUT_TOKENS (one request's reservation, 132000 by default)
#AI_REQUESTS_PER_USER_HOUR=30    # 1-1000
#AI_RESULT_RETENTION_HOURS=168   # 1-2160; suggestions are deleted after this

# --- evidence & authz depth -------------------------------------------
# External audit anchoring (docs/runbooks/audit-anchoring.md): the daily signed checkpoints are
# batched into a Merkle tree whose root is timestamped by an RFC 3161 TSA and/or logged in Sigstore
# Rekor v2. Off unless drivers are listed.
#AUDIT_ANCHOR_DRIVERS=           # csv of rfc3161,rekor
#AUDIT_ANCHOR_TSA_URLS=https://timestamp.sigstore.dev/api/v1/timestamp,https://freetsa.org/tsr   # required with rfc3161; tried in order; prod/staging: https unless operator-run
#AUDIT_ANCHOR_TSA_CERTS_FILE=/run/secrets/tsa-certs.pem   # required with rfc3161: PEM bundle of pinned TSA certificates/roots
#AUDIT_ANCHOR_REKOR_URL=https://log2025-1.rekor.sigstore.dev   # required with rekor (current shard; shards rotate)
#AUDIT_ANCHOR_REKOR_LOG_KEY_FILE=/run/secrets/rekor.pub   # required with rekor: the logs' PEM public keys (first = current shard; keep old shards' keys after it)
#AUDIT_ANCHOR_REKOR_ORIGIN=log2025-1.rekor.sigstore.dev   # checkpoint origins, csv (first = current); default the URL's host, REQUIRED with several log keys or keys without the rekor driver
#AUDIT_ANCHOR_TIMEOUT_MS=15000   # 1000-120000 per anchor call
# Optional OpenFGA engine behind the authz port (docs/runbooks/openfga.md). Postgres stays the source
# of truth; shadow compares only, enforce may narrow external principals' access (fails closed).
#AUTHZ_ENGINE=postgres           # postgres | openfga
#AUTHZ_OPENFGA_URL=http://openfga:8080   # required with openfga; prod/staging: https unless operator-run
#AUTHZ_OPENFGA_API_TOKEN=        # the server's preshared key, if it requires one
#AUTHZ_OPENFGA_MODE=shadow       # shadow | enforce
#AUTHZ_OPENFGA_SHADOW_SAMPLE=1   # 0-1 fraction of external checks compared in shadow mode
#AUTHZ_OPENFGA_TIMEOUT_MS=1500   # 100-30000 per engine call

# --- audit, outbox, jobs ---------------------------------------------------
AUDIT_RETENTION_MONTHS=84        # partitions older than this are dropped by the daily audit.maintenance job
AUDIT_IP_TRUNCATE=true           # store /24 (v4) / /48 (v6) networks in audit rows; full IPs stay out of the 7-year log
OUTBOX_POLL_INTERVAL_MS=1000     # relay idle poll; batches drain back-to-back
JOBS_POLL_INTERVAL_MS=2000       # pg-boss worker poll (LISTEN/NOTIFY is off: PgBouncer-safe)

# --- object storage --------------------------------------------------------
STORAGE_DRIVER=fs                # fs | s3
STORAGE_FS_PATH=/data/storage
#S3_BUCKET=fundroom-documents
#S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
#S3_REGION=auto
#S3_ACCESS_KEY_ID=
#S3_SECRET_ACCESS_KEY=
#S3_FORCE_PATH_STYLE=false
UPLOAD_MAX_BYTES=5368709120      # 5 GiB ceiling for one upload; workspaces can lower it
RENDER_MAX_BYTES=209715200       # 200 MiB: larger blobs are stored but not previewed (download only)

# --- virus scanning (data room) ---------------------------------------------
AV_DRIVER=noop                   # noop (uploads marked "unscanned") | clamd (ClamAV INSTREAM)
#AV_ACCEPT_UNSCANNED=false       # staging/prod refuse AV_DRIVER=noop unless this is true
#CLAMD_HOST=clamav
#CLAMD_PORT=3310
#CLAMD_TIMEOUT_MS=120000

# --- email -----------------------------------------------------------------
MAILER_DRIVER=smtp               # smtp | resend | postmark | ses (ESP drivers need MAIL_FROM on a domain verified at the provider)
MAIL_FROM=investors@example.com
#MAIL_FROM_NAME=Acme Investor Relations
SMTP_URL=smtp://localhost:1025   # Mailpit in dev
# staging/prod: a relay outside the private network needs smtps:// or ?requireTLS=true, and
# tls.rejectUnauthorized=false is refused (STARTTLS stripping would expose sign-in codes).
# Webhook for every ESP driver: https://<your host>/webhooks/email/<driver> (bounces, complaints, opens, clicks)
# resend
#RESEND_API_KEY=re_...
#RESEND_WEBHOOK_SECRET=whsec_... # signing secret of the Resend webhook; unset = webhook answers 404
# postmark
#POSTMARK_SERVER_TOKEN=
#POSTMARK_BROADCAST_STREAM=broadcast   # message stream for investor updates; everything else goes to "outbound"
#POSTMARK_WEBHOOK_USER=fundroom        # basic auth you put in the webhook URL: https://user:pass@host/webhooks/email/postmark
#POSTMARK_WEBHOOK_PASSWORD=            # >= 16 chars, e.g. $(openssl rand -hex 16)
# ses (API v2, SigV4); events come from a configuration set -> SNS topic -> HTTPS subscription
#AWS_REGION=eu-west-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=                    # temporary (STS) credentials only
#SES_CONFIGURATION_SET=fundroom
#SES_SNS_TOPIC_ARNS=arn:aws:sns:eu-west-1:123456789012:fundroom-ses-events   # only these topics are accepted

# --- integrations hub (docs/integrations/README.md) -------------------------
# Deployment-level OAuth apps. A provider whose client is unset shows "not configured" and cannot be
# connected; set each ID/SECRET pair together (or neither). Redirect URI: ${BASE_URL}/oauth/integrations/callback.
# Stripe (restricted key), Calendly (personal access token) and Cal.com need nothing here.
#INTEGRATIONS_QUICKBOOKS_CLIENT_ID=
#INTEGRATIONS_QUICKBOOKS_CLIENT_SECRET=
#INTEGRATIONS_QUICKBOOKS_ENVIRONMENT=production  # production | sandbox (Intuit development keys)
#INTEGRATIONS_XERO_CLIENT_ID=
#INTEGRATIONS_XERO_CLIENT_SECRET=
#INTEGRATIONS_SLACK_CLIENT_ID=
#INTEGRATIONS_SLACK_CLIENT_SECRET=

# --- outbound HTTP / security headers --------------------------------------
OUTBOUND_HTTP_ALLOW_PRIVATE=false  # SSRF guard: true lets webhooks/OIDC reach private ranges (dev); prod must list hosts instead
#OUTBOUND_HTTP_ALLOW_PRIVATE_HOSTS=keycloak.internal,10.0.0.5
#WEBHOOK_ALLOW_PRIVATE_HOSTS=hooks.internal,10.0.0.7  # outbound webhooks only (tenant-chosen URLs; never inherits the two above); private address + plain http allowed for these hosts; prod refuses loopback
#ESIGN_ALLOW_PRIVATE_HOSTS=documenso.internal,10.0.0.8  # e-sign vendor base URLs only (self-hosted Documenso/DocuSeal on the LAN, and their object-store host); never inherits the OUTBOUND_HTTP_* lists; same rules as WEBHOOK_ALLOW_PRIVATE_HOSTS (prod/staging refuse loopback, unspecified, wildcard)
#ACCREDITATION_ALLOW_PRIVATE_HOSTS=accred-proxy.internal,10.0.0.10  # accreditation vendor API hosts reachable on a private address (test rigs / sandbox proxy only); never inherits the OUTBOUND_HTTP_* lists; prod/staging refuse loopback, unspecified, wildcard
#SSO_ALLOW_PRIVATE_HOSTS=keycloak.internal,10.0.0.11  # SSO client only (OIDC discovery/JWKS, SAML metadata of an IdP on the LAN, test rigs); never inherits the OUTBOUND_HTTP_* lists; prod/staging refuse loopback, unspecified, wildcard
#INTEGRATIONS_ALLOW_PRIVATE_HOSTS=qbo-fake.internal  # integrations client only (tests / local vendor fakes); never inherits the OUTBOUND_HTTP_* lists; prod/staging refuse loopback, unspecified, wildcard
HSTS=true                        # Strict-Transport-Security on https responses
HSTS_PRELOAD=false               # adds preload + includeSubDomains; only for a standalone domain you own
#HSTS_INCLUDE_SUBDOMAINS=         # unset: on, except when served under a path (BASE_PATH or a BASE_URL path), which owns no host; true/HSTS_PRELOAD refused there. PATH_MOUNTS alone keeps it: responses through a mount never carry HSTS

# --- observability ---------------------------------------------------------
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=fundroom
#METRICS_ENABLED=                # Prometheus text at /metrics. Unset: on in dev/test; in staging/prod
                                 # only with METRICS_TOKEN (true without a token is refused there)
#METRICS_TOKEN=                  # require Authorization: Bearer <token> on /metrics (and full /readyz)
ERROR_REPORTING_DSN=            # GlitchTip / Sentry compatible

# --- operator toggles ------------------------------------------------------
UPDATE_CHECK=true                # static index.json fetch, no identifiers sent; set false to opt out
UPDATE_CHECK_URL=https://releases.fundroom.com/index.json  # release index read by the update check; https in staging/prod
I18N_PSEUDO_LOCALE=false         # offer the en-XA pseudo-locale in the language switch (layout/i18n QA)
