{
  "name": "fundroom",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hostable, embeddable, gated investor-relations portal",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:wp": "node scripts/build-wordpress-plugin.mjs",
    "dev": "turbo run dev",
    "lint": "biome check . && pnpm lint:deps && pnpm lint:sql && pnpm lint:i18n",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run codegen && tsc -b tsconfig.json",
    "test": "vitest run --project unit --project ui --project web",
    "test:integration": "vitest run --project integration",
    "mutation:authz": "pnpm --filter @fundroom/authz mutation",
    "test:all": "vitest run",
    "test:watch": "vitest --project unit --project ui --project web",
    "coverage": "vitest run --project unit --project ui --project web --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "packages:pack-check": "node scripts/release/pack-check.mjs",
    "prepare": "lefthook install",
    "lint:deps": "depcruise --config .dependency-cruiser.cjs .",
    "lint:sql": "node scripts/check-sql-hygiene.mjs",
    "lint:i18n": "node scripts/check-i18n.mjs && node --test scripts/check-i18n.test.mjs",
    "gen:deploy": "node scripts/render-deploy-templates.mjs",
    "gen:deploy:check": "node scripts/render-deploy-templates.mjs --check",
    "codegen": "turbo run codegen",
    "storybook": "pnpm --filter @fundroomhq/ui storybook",
    "docker:clean": "docker image prune -f && docker builder prune -f --filter until=72h && docker volume prune -f && docker system df"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^18.2.0",
    "lefthook": "^2.1.12",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
