{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "noEmit": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "@testing-library/jest-dom"],
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["dist"],
  "references": [
    { "path": "../../packages/branding" },
    { "path": "../../packages/charts" },
    { "path": "../../packages/decimal" },
    { "path": "../../packages/markdown" },
    { "path": "../../packages/round-terms" },
    { "path": "../../packages/sdk" },
    { "path": "../../packages/ui" }
  ]
}
