{
  "name": "@fundroom/web",
  "version": "1.0.0-rc.0",
  "private": true,
  "description": "FundRoom web app: Vite + React 19 + TanStack Router SPA with the investor, admin and embed route trees",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "codegen": "node ../../scripts/i18n-pseudo.mjs && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale && tsr generate",
    "dev": "vite",
    "build": "pnpm codegen && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --project web",
    "clean": "rm -rf dist src/paraglide *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/branding": "workspace:*",
    "@fundroom/charts": "workspace:*",
    "@fundroom/decimal": "workspace:*",
    "@fundroom/markdown": "workspace:*",
    "@fundroom/round-terms": "workspace:*",
    "@fundroom/sdk": "workspace:*",
    "@fundroomhq/ui": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.35",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "lucide-react": "^1.45.0",
    "qrcode": "^1.5.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.2",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "^1.168.37",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^24.13.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "@tanstack/router-cli": "^1.167.35"
  }
}
