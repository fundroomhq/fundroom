# Copy to deploy/compose/.env (never committed). Everything else has a default in compose.yaml;
# see the repository's .env.example for the full variable reference.

# Public address. Caddy issues the certificate for FUNDROOM_DOMAIN; BASE_URL defaults to https://<it>.
# (Renamed from SEEDHOST_DOMAIN, which compose.yaml still reads when this is unset; the same goes
# for SEEDHOST_SECRET_KEY and SEEDHOST_IMAGE below.)
FUNDROOM_DOMAIN=investors.example.com
BASE_URL=https://investors.example.com
ACME_EMAIL=ops@example.com
INSTANCE_NAME=Acme Investor Portal

# Database password for the bundled Postgres (also embedded in DATABASE_URL by compose.yaml).
# Required: compose refuses to start without it. Generate one: openssl rand -hex 24
# Upgrading a stack whose .env had no POSTGRES_PASSWORD? Its database was created with the old
# default: set POSTGRES_PASSWORD=seedhost, then rotate it (docs/runbooks/rotate-keys.md).
POSTGRES_PASSWORD=

# Outbound mail (required in prod). A relay outside your network must use TLS that cannot be
# stripped: smtps://…:465, or smtp://…:587?requireTLS=true (plain STARTTLS is refused in prod).
# Mailpit/dev: smtp://mailpit:1025
SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=investors@example.com
MAIL_FROM_NAME=Acme Investor Relations
# Or send through an ESP's API and get bounces, complaints, opens and clicks back through
# its webhook: MAILER_DRIVER=resend|postmark|ses plus that provider's keys (full reference in the
# repository's .env.example). MAIL_FROM must be on a domain verified at the provider.
#MAILER_DRIVER=postmark
#RESEND_API_KEY=re_...
#RESEND_WEBHOOK_SECRET=whsec_...
#POSTMARK_SERVER_TOKEN=
#POSTMARK_BROADCAST_STREAM=broadcast
#POSTMARK_WEBHOOK_USER=fundroom
#POSTMARK_WEBHOOK_PASSWORD=
#AWS_REGION=eu-west-1
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=
#SES_CONFIGURATION_SET=fundroom
#SES_SNS_TOPIC_ARNS=arn:aws:sns:eu-west-1:123456789012:fundroom-ses-events

# Master key: leave empty to have the first start generate one into the data volume
# (back it up!), or set it yourself: openssl rand -base64 32
FUNDROOM_SECRET_KEY=

# Pin the image; `latest` follows releases, `edge` follows main.
FUNDROOM_IMAGE=ghcr.io/fundroomhq/fundroom:latest

# Optional: run jobs in a separate `worker` container instead of inside `app`. Both lines together:
# the profile starts the worker, WORKER_MODE=external stops `app` from consuming jobs as well.
#COMPOSE_PROFILES=worker
#WORKER_MODE=external

# Optional: fix the first-run setup token instead of reading it from the logs.
#SETUP_TOKEN=
# Optional: Prometheus metrics. In prod /metrics is served only with a token (openssl rand -hex 24)
# and the caddy edge refuses it from outside; scrape http://app:3000/metrics on the Compose network
# with `Authorization: Bearer <token>`, or set EDGE_EXPOSE_METRICS=true to scrape through the edge.
#METRICS_TOKEN=
#EDGE_EXPOSE_METRICS=true
# Optional: a CDN or load balancer in front of Caddy. Caddy keeps X-Forwarded-* only from these
# addresses (space-separated CIDRs, or private_ranges); raise TRUST_PROXY_HOPS by one per such hop.
# Empty (the default) trusts nobody, so a client cannot choose its own address, scheme or host.
#EDGE_TRUSTED_PROXIES=173.245.48.0/20 103.21.244.0/22
#TRUST_PROXY_HOPS=2
# Optional: the admin health page and `fundroom doctor` check for new releases (no identifiers are
# sent; nothing is ever installed automatically). Turn it off, or point it at a mirror (https).
#UPDATE_CHECK=false
#UPDATE_CHECK_URL=https://releases.fundroom.com/index.json

# --- data room -------------------------------------------------------
# Virus scanning: noop marks every upload "unscanned" (admins decide per workspace whether
# unscanned files are servable); clamd needs the `av` profile: docker compose --profile av up -d
# plus AV_DRIVER=clamd. APP_ENV=prod refuses noop unless AV_ACCEPT_UNSCANNED=true: delete that
# line once clamd runs.
AV_DRIVER=noop
AV_ACCEPT_UNSCANNED=true
#CLAMD_HOST=clamav
UPLOAD_MAX_BYTES=5368709120

# --- custom domains --------------------------------------------------
# A workspace portal on the customer's own hostname (investors.acme.com). TENANCY_MODE=multi is
# required: it is what lets a Host header other than FUNDROOM_DOMAIN resolve a workspace at all.
#TENANCY_MODE=multi
# What customers point their CNAME at. Defaults to FUNDROOM_DOMAIN, which is what a single
# install wants; a managed edge names a dedicated host here. See docs/runbooks/custom-domains.md.
#CUSTOM_DOMAIN_CNAME_TARGET=investors.example.com
# caddy-ask (default): the caddy service gets a certificate per verified domain from the app's
# `ask` endpoint. manual: we verify DNS only and you terminate TLS on your own edge.
#CUSTOM_DOMAIN_DRIVER=caddy-ask
# An apex (acme.com itself) cannot hold a CNAME, so it points A/AAAA at the edge instead. Left
# unset, verification resolves CUSTOM_DOMAIN_CNAME_TARGET's own A/AAAA and accepts the apex when
# the addresses match, which needs no configuration and follows the edge if it moves. Set this
# only when the edge answers on stable anycast addresses its own DNS does not name.
#CUSTOM_DOMAIN_EDGE_ADDRESSES=203.0.113.10,2001:db8::10
# DNS-over-HTTPS resolvers used for verification; two DISTINCT resolvers must agree (identical
# hosts are deduped, so listing 1.1.1.1 twice is one resolver). Default: Cloudflare, Google.
#DOH_ENDPOINTS=https://1.1.1.1/dns-query,https://8.8.8.8/resolve
# Issue from another ACME server (e2e runs a local Pebble). ACME_CA_ROOT is a PEM file, mounted
# into the caddy container, holding that CA's own root; both empty means Let's Encrypt / ZeroSSL.
#ACME_CA=https://pebble:14000/dir
#ACME_CA_ROOT=/etc/caddy/acme-ca-root.pem
