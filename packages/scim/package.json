{
  "name": "@fundroom/scim",
  "version": "0.0.0",
  "private": true,
  "description": "Kernel SCIM 2.0 provisioning service for FundRoom: per-workspace SCIM bearer tokens, the Users/Groups protocol surface Entra ID and Okta speak, the per-workspace scim_user projection, and SCIM group → staff role mapping",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/audit": "workspace:*",
    "@fundroom/db": "workspace:*",
    "@fundroom/sso": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
