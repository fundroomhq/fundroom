{
  "name": "@fundroom/embed",
  "version": "0.2.0-rc.0",
  "private": true,
  "description": "Browser loader that mounts a FundRoom portal in a host page: iframe, bridge, resize, history sync",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts.d.ts",
      "default": "./dist/artifacts.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "codegen": "node scripts/build-artifacts.mjs",
    "codegen:check": "node scripts/build-artifacts.mjs --check",
    "build": "pnpm codegen && tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "esbuild": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
