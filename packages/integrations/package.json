{
  "name": "@fundroom/integrations",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "Kernel integrations hub for FundRoom: third-party connections with sealed credentials, the OAuth 2.0 authorization-code flow with browser binding, refresh-token rotation under a lease, connection health, booking links and verified booking webhooks, and the ModuleServices.integrations port",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/audit": "workspace:*",
    "@fundroom/crypto": "workspace:*",
    "@fundroom/db": "workspace:*",
    "@fundroom/domain": "workspace:*",
    "@fundroom/events": "workspace:*",
    "@fundroom/identity": "workspace:*",
    "@fundroom/module-kit": "workspace:*",
    "@fundroom/ports": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
