{
  "name": "@fundroom/sanctions",
  "version": "0.0.0",
  "private": true,
  "description": "Kernel sanctions screening for FundRoom: screening tenant companies against sanctions lists, the name matcher (normalise + token-set Jaro-Winkler), the hold/suspend decisions and the list refresh / re-screen jobs",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/audit": "workspace:*",
    "@fundroom/control-plane": "workspace:*",
    "@fundroom/db": "workspace:*",
    "@fundroom/ports": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
