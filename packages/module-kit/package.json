{
  "name": "@fundroom/module-kit",
  "version": "0.0.0",
  "private": true,
  "description": "defineModule() manifests, the module registry (dependency order, enablement, permissions, slots, flags) and the /api/v1/modules bootstrap for FundRoom",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@hono/zod-openapi": "catalog:",
    "@fundroom/audit": "workspace:*",
    "@fundroom/contracts": "workspace:*",
    "@fundroom/crypto": "workspace:*",
    "@fundroom/db": "workspace:*",
    "@fundroom/domain": "workspace:*",
    "@fundroom/events": "workspace:*",
    "@fundroom/ports": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
