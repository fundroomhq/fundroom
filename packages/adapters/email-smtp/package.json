{
  "name": "@fundroom/email-smtp",
  "version": "0.0.0",
  "private": true,
  "description": "MailerPort adapter over nodemailer SMTP (Mailpit in dev)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/ports": "workspace:*",
    "nodemailer": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/nodemailer": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
