{
  "name": "@fundroom/sheets-google",
  "version": "0.0.0",
  "private": true,
  "description": "SpreadsheetPort over the Google Sheets v4 REST API using a service account (RS256 JWT bearer), plus a noop driver that switches the integration off",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/ports": "workspace:*"
  },
  "devDependencies": {
    "@fundroom/outbound-http": "workspace:*",
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
