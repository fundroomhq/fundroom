{
  "name": "@fundroom/anchor-rekor",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "AuditAnchorPort over Sigstore Rekor v2: hashedrekord entries signed with a key-ring-derived ECDSA P-256 key, inclusion proofs and signed checkpoints verified offline",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/ports": "workspace:*"
  },
  "devDependencies": {
    "@fundroom/audit": "workspace:*",
    "@fundroom/outbound-http": "workspace:*",
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
