{
  "name": "@fundroom/sanctions-ofac",
  "version": "0.0.0",
  "private": true,
  "description": "SanctionsScreeningPort over the US OFAC Sanctions List Service: downloads the SDN and consolidated lists, caches them on disk and matches locally",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/ports": "workspace:*",
    "@fundroom/sanctions": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
