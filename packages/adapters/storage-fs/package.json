{
  "name": "@fundroom/storage-fs",
  "version": "1.0.0-rc.0",
  "private": true,
  "description": "ObjectStoragePort adapter over the local filesystem with a tus resumable-upload server (single-node installs)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/ports": "workspace:*",
    "@tus/file-store": "catalog:",
    "@tus/server": "catalog:"
  },
  "devDependencies": {
    "@fundroom/storage": "workspace:*",
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
