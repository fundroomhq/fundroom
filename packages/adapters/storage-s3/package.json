{
  "name": "@fundroom/storage-s3",
  "version": "0.0.0",
  "private": true,
  "description": "ObjectStoragePort adapter over the AWS SDK v3 (S3, R2, B2, Garage, SeaweedFS) with presigned multipart uploads",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@fundroom/ports": "workspace:*"
  },
  "devDependencies": {
    "@fundroom/storage": "workspace:*",
    "@types/node": "^24.13.4",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
