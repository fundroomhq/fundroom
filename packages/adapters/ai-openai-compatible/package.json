{
  "name": "@fundroom/ai-openai-compatible",
  "version": "0.0.0",
  "private": true,
  "description": "ModelPort over the OpenAI-compatible chat completions API: self-hosted Ollama, vLLM, llama.cpp server, LM Studio, or a hosted OpenAI-compatible provider",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/ports": "workspace:*"
  },
  "devDependencies": {
    "@fundroom/ai": "workspace:*",
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
