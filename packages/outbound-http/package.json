{
  "name": "@fundroom/outbound-http",
  "version": "1.0.0-rc.0",
  "private": true,
  "description": "SSRF-guarded OutboundHttpPort: DNS pre-resolution, private-range deny, pinned addresses, timeouts, size caps",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/ports": "workspace:*",
    "undici": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
