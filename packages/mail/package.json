{
  "name": "@fundroom/mail",
  "version": "1.0.0-rc.0",
  "private": true,
  "description": "React Email templates and the templated MailerPort decorator for FundRoom transactional email",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/i18n": "workspace:*",
    "@fundroom/ports": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
