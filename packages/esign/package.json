{
  "name": "@fundroom/esign",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "Kernel e-signature service for FundRoom: the ESignPort connection per workspace, envelopes, status sync and artifact collection jobs, the e-sign NDA ceremony, and the in-memory adapter every test uses",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/audit": "workspace:*",
    "@fundroom/clickwrap": "workspace:*",
    "@fundroom/crypto": "workspace:*",
    "@fundroom/db": "workspace:*",
    "@fundroom/domain": "workspace:*",
    "@fundroom/events": "workspace:*",
    "@fundroom/identity": "workspace:*",
    "@fundroom/module-kit": "workspace:*",
    "@fundroom/ports": "workspace:*",
    "@fundroom/storage": "workspace:*",
    "drizzle-orm": "catalog:",
    "pdf-lib": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:"
  }
}
