{
  "name": "@fundroom/custom-domains",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "Custom portal domains for FundRoom: hostname rules, challenge tokens, expected DNS records, the DNS verdict and state machine (pure), plus the repo, admin service, hostname lookup cache and verification jobs",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/audit": "workspace:*",
    "@fundroom/db": "workspace:*",
    "@fundroom/ports": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
