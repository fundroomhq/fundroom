{
  "name": "@fundroomhq/ui",
  "version": "0.0.0",
  "private": false,
  "description": "FundRoom design system: shadcn-style React 19 components on Radix, a Tailwind v4 theme over @fundroomhq/tokens, light/dark/system theming and runtime workspace themes",
  "license": "MIT",
  "homepage": "https://github.com/fundroomhq/fundroom/tree/main/packages/ui#readme",
  "bugs": "https://github.com/fundroomhq/fundroom/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fundroomhq/fundroom.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./dist/styles/tokens.css",
    "./tokens.json": "./dist/theme/default-tokens.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo*",
    "!dist/**/*.map",
    "!dist/**/*.test.*",
    "!dist/test"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./theme": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme/index.js"
      },
      "./styles.css": "./dist/styles/index.css",
      "./tokens.css": "./dist/styles/tokens.css",
      "./tokens.json": "./dist/theme/default-tokens.json",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "codegen": "node scripts/copy-tokens.mjs",
    "codegen:check": "node scripts/copy-tokens.mjs --check",
    "build": "pnpm codegen && tsc -b tsconfig.json && node scripts/build-styles.mjs",
    "prepack": "rm -rf dist && pnpm build",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "test": "vitest run --project ui",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet",
    "clean": "rm -rf dist storybook-static *.tsbuildinfo"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "dependencies": {
    "@fundroomhq/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.45.0",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/react-vite": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^24.13.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
