{
  "name": "@fundroom/markdown",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "The Markdown subset rich-text blocks are stored as: parser, safe HTML and plain-text renderers, ProseMirror JSON round-trip (no I/O, no dependencies)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
