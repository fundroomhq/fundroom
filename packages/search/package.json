{
  "name": "@fundroom/search",
  "version": "0.1.0-rc.0",
  "private": true,
  "description": "Workspace search for FundRoom: the core.search_entry index modules write through services.search, ACL-filtered Postgres full-text + trigram queries, snippets and the reindex job",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json tsconfig.test.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/db": "workspace:*",
    "@fundroom/module-kit": "workspace:*",
    "@fundroom/ports": "workspace:*",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
