{
  "name": "@fundroom/ports",
  "version": "1.0.0-rc.0",
  "private": true,
  "description": "TypeScript interfaces (ports) that adapters implement and application code depends on",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@fundroom/domain": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "catalog:"
  }
}
