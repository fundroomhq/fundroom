# Code owners. Security-sensitive paths require two approving reviews, one of them from
# @fundroomhq/security (branch protection: "Require review from Code Owners" + 2 approvals on
# main). The teams belong to the fundroomhq organisation and must exist there before branch protection relies on them.
#
# Later rules win (GitHub uses the LAST matching pattern), so the catch-all comes first and the
# specific paths after it. Every path below exists; `scripts/evidence/change-management.mjs`
# reads this file to flag security-sensitive PRs that merged with fewer than two approvals.

*                                         @fundroomhq/core

# Tenancy, RLS and the database — two reviews.
/packages/config/                         @fundroomhq/security @fundroomhq/core
/packages/db/src/rls/                     @fundroomhq/security @fundroomhq/core
/packages/db/src/tenant/                  @fundroomhq/security @fundroomhq/core
/packages/db/src/break-glass/             @fundroomhq/security @fundroomhq/core
/packages/db/migrations/                  @fundroomhq/security @fundroomhq/core
/modules/*/migrations/                    @fundroomhq/security @fundroomhq/core
/apps/server/src/tenancy.ts               @fundroomhq/security @fundroomhq/core

